# Neon pooled connection string for application requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Neon direct (non-pooled) connection string for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Clerk project credentials (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Optional seed owner for creating the demo account and starter presentations.
SEED_OWNER_EMAIL=""
SEED_OWNER_CLERK_ID=""

# Optional DeepL API key for authenticated presentation-copy translation.
DEEPL_API_KEY=""
# Optional DeepL API base URL: https://api-free.deepl.com or https://api.deepl.com
DEEPL_API_URL="https://api-free.deepl.com"

# Optional LiveKit Cloud credentials for presenter/guest camera and microphone rooms.
# Use the secure WebSocket URL shown for your LiveKit project (wss://...).
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
